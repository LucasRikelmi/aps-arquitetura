# Copie para .env. Nunca publique credenciais reais.
DATABASE_URL=postgresql://aps_auth:troque_esta_senha@127.0.0.1:5432/aps_auth
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=3000
PG_IDLE_TIMEOUT_MS=10000
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Para BD remoto, configure TLS com certificado válido.
# PGSSLROOTCERT=/caminho/ca.pem

# Lista C: sessoes no servidor
SESSION_INACTIVITY_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Obrigatorio no ambiente de producao, HTTPS
PUBLIC_ORIGIN=https://exemplo.com

# Serviço de notificações (apenas se utilizar SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Correções herdadas da APS — 32+ bytes aleatórios independentes em produção
CSRF_SECRET=development-only-secret-please-change-now-123456
LOGIN_RATE_SECRET=development-only-login-secret-change-12345
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_SECONDS=60
